#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


python manage.py migrate --run-syncdb
PORT=${PORT:-8001}
# 单进程 + Gevent 协程架构，共享单一 Python 堆内存任务中心
WORKERS=${GUNICORN_WORKER_NUM:-1}
exec gunicorn -w ${WORKERS} -b 0.0.0.0:${PORT} django_vue_cli.wsgi:application --timeout 120 --worker-class=gevent --worker-connections=1000

