#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


if [ -z "${DJANGO_SECRET_KEY:-}" ]; then
  if [ -f "/app/data/secret.key" ]; then
    export DJANGO_SECRET_KEY="$(cat /app/data/secret.key)"
  else
    mkdir -p /app/data
    export DJANGO_SECRET_KEY="$(python3 -c 'import secrets; print(secrets.token_hex(32))')"
    echo "$DJANGO_SECRET_KEY" > /app/data/secret.key 2>/dev/null || true
  fi
fi

python manage.py migrate --run-syncdb
PORT=${PORT:-8001}
# 单进程 + 多线程 (gthread) 架构：共享内存任务中心，同时在文件 I/O 与图片缩略图计算时释放 GIL，彻底避免单线程卡死
WORKERS=${GUNICORN_WORKER_NUM:-1}
THREADS=${GUNICORN_THREADS:-8}
TIMEOUT=${GUNICORN_TIMEOUT:-300}
exec gunicorn -w ${WORKERS} --threads ${THREADS} -b 0.0.0.0:${PORT} django_vue_cli.wsgi:application --timeout ${TIMEOUT} --worker-class=gthread

